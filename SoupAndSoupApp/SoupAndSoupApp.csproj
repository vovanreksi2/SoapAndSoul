<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UseXamlCompiler>true</UseXamlCompiler>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />

    <PackageReference Include="Avalonia.Desktop" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.1" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.0.3" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoupAndSoup.Data\SoupAndSoup.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Components\SoapToast.axaml.cs">
      <DependentUpon>SoapToast.axaml</DependentUpon>
    </Compile>
    <Compile Update="Components\RecipeMetricsUserControl.axaml.cs">
      <DependentUpon>RecipeMetricsUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SoapDesignerView.axaml.cs">
      <DependentUpon>SoapDesignerView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
