<UserControl
    x:Class="SoupAndSoupApp.Components.RecipeMetricsUserControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    mc:Ignorable="d">

    <UserControl.Styles>

        <Style Selector="Grid.MetricGrid">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
        </Style>

        <!--  Border  -->
        <Style Selector="Border.MetricBorder">
            <Setter Property="Background" Value="{StaticResource ReceiptDetailPrimarySolidColorBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!--  TextBlock for label  -->
        <Style Selector="TextBlock.MetricLabelText">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!--  TextBlock for value  -->
        <Style Selector="TextBlock.MetricValueText">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!--  TextBox for value  -->
        <Style Selector="TextBox.MetricValueText">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />

        </Style>

    </UserControl.Styles>

    <Grid
        Classes="MetricGrid"
        Focusable="False"
        PointerPressed="DisplayTextBlock_PointerPressed"
        RowDefinitions="*, *">

        <Border Grid.RowSpan="2" Classes="MetricBorder" />

        <TextBlock
            Grid.Row="0"
            Classes="MetricLabelText"
            Text="{Binding #RootControl.Title}" />

        <TextBlock
            Grid.Row="1"
            Classes="MetricValueText"
            IsVisible="{Binding !#RootControl.IsEditing}"
            Text="{Binding #RootControl.FormattedValue}" />

        <TextBox
            x:Name="EditTextBox"
            Grid.Row="1"
            Classes="MetricValueText"
            IsVisible="{Binding #RootControl.IsEditing}"
            KeyDown="EditTextBox_OnKeyDown"
            Text="{Binding #RootControl.Value, Mode=TwoWay, StringFormat='{}{0:F0}'}" />

    </Grid>
</UserControl>
