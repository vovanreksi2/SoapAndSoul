<UserControl
    x:Class="SoupAndSoupApp.Components.IngredientItemsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SoupAndSoupApp.Components"
    xmlns:converters="clr-namespace:SoupAndSoupApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SoupAndSoupApp.Models"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="models:ComponentGroup"
    mc:Ignorable="d">
    <UserControl.Resources>

        <system:Double x:Key="IngredientCheckBoxWidth">150</system:Double>
        <system:Double x:Key="IngredientCheckBoxHeight">150</system:Double>

        <converters:TextVisibilityConverter x:Key="TextVisibilityConverter" />

        <!--  Button  -->
        <ControlTemplate x:Key="MoldButtonControlTemplate" TargetType="Button">
            <Grid>
                <Border Background="Transparent" CornerRadius="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=CornerRadius.TopRight}" />

                <Rectangle
                    RadiusX="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=CornerRadius.TopRight}"
                    RadiusY="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=CornerRadius.BottomLeft}"
                    Stroke="{TemplateBinding BorderBrush}"
                    StrokeDashArray="5, 6"
                    StrokeThickness="2" />

                <StackPanel
                    Margin="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <Grid Width="40" Height="40">
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Regular"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="Bold"
                            Foreground="{TemplateBinding Foreground}"
                            Text="+" />
                    </Grid>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="Bold"
                        Foreground="{TemplateBinding Foreground}"
                        Text="Додати" />

                </StackPanel>
            </Grid>
        </ControlTemplate>
        <!--  End  -->

        <!--  CheckBox  -->
        <ControlTemplate
            x:Key="IngredientCBControlTemplate"
            x:DataType="models:ComponentModel"
            TargetType="ToggleButton">

            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ColumnDefinitions="* 90"
                RowDefinitions="100 50"
                ShowGridLines="False"
                ToolTip.Tip="{Binding Name}">

                <Border
                    x:Name="BackgroundBorder"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12" />

                <Image
                    x:Name="IngredientImage"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Source="{Binding ImagePath}"
                    Stretch="Uniform" />


                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Margin="5"
                        Classes="edit-button miniButton cbButton"
                        Command="{Binding EditCommand}"
                        CommandParameter="{Binding .}"
                        Focusable="False"
                        IsHitTestVisible="True" />
                    <Button
                        Margin="5"
                        Classes="delete-button miniButton cbButton"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding .}"
                        Focusable="False"
                        IsHitTestVisible="True" />
                </StackPanel>



                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}"
                    Foreground="{TemplateBinding Foreground}"
                    Text="{Binding Name}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap">

                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource TextVisibilityConverter}">
                            <Binding Path="ShowAmountInButton" />
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    ColumnDefinitions="Auto * Auto">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource AndConverter}">
                            <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ShowAmountInButton" />
                        </MultiBinding>
                    </Grid.IsVisible>

                    <Button
                        Grid.Column="0"
                        Classes="button-mainColor"
                        Command="{Binding DecreaseAmountCommand}"
                        Content="-"
                        CornerRadius="0 0 0 12" />

                    <TextBox
                        Grid.Column="1"
                        Margin="0,0,0,3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        BorderBrush="{StaticResource PrimaryAccentColorLighter}"
                        Text="{Binding AmountInRecipe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F0}'}" />

                    <Button
                        Grid.Column="2"
                        Margin="0,0,2,2"
                        Classes="button-mainColor"
                        Command="{Binding IncreaseAmountCommand}"
                        Content="+"
                        CornerRadius="0 0 12 0" />

                </Grid>
            </Grid>
        </ControlTemplate>
        <!--  End  -->

        <!--  ListBox  -->
        <DataTemplate x:Key="IngredientsCBDataTemplate" DataType="models:ComponentModel">
            <ToggleButton
                Width="{StaticResource IngredientCheckBoxWidth}"
                Height="{StaticResource IngredientCheckBoxHeight}"
                Margin="0,0,20,30"
                Classes="IngredientCheckBox"
                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Template="{StaticResource IngredientCBControlTemplate}" />
        </DataTemplate>

        <DataTemplate x:Key="IngredientsButtonDataTemplate" DataType="models:ComponentModel">
            <Button
                Width="{StaticResource IngredientCheckBoxWidth}"
                Height="{StaticResource IngredientCheckBoxHeight}"
                Margin="0,0,20,30"
                Classes="MoldButton"
                Command="{Binding NewItemCommand, RelativeSource={RelativeSource AncestorType=components:IngredientItemsControl}}"
                CommandParameter="{Binding Path=Type, RelativeSource={RelativeSource AncestorType=components:IngredientItemsControl}}"
                Template="{StaticResource MoldButtonControlTemplate}" />
        </DataTemplate>

        <!--  END  -->

    </UserControl.Resources>

    <UserControl.Styles>

        <!--  Buttons  -->
        <Style Selector="Button.MoldButton">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentColor}" />
            <Setter Property="Background" Value="{StaticResource PrimaryAccentColorLighter}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.MoldButton:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentColorDarkest}" />
            <Setter Property="Background" Value="{StaticResource PrimaryAccentColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!--  Buttons end  -->

        <!--  Toogle Styles  -->

        <Style Selector="ToggleButton.IngredientCheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        </Style>
        <Style Selector="ToggleButton.IngredientCheckBox:not(:checked):pointerover">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBorderColor}" />
            <Setter Property="Background" Value="{StaticResource TileHoverBackgroundColor}" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style Selector="ToggleButton.IngredientCheckBox:checked /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderColor}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="ToggleButton.IngredientCheckBox:not(:checked) /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.IngredientCheckBox:not(:checked):pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderColor}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BoxShadow" Value="{Binding Source={StaticResource BorderColor}, Converter={StaticResource ColorToBoxShadowConverter}, ConverterParameter=20}" />
            <Setter Property="Margin" Value="2" />
        </Style>




        <!--  END  -->

        <!--  Items control  -->
        <Style Selector="ItemsControl.lbSoapComponents">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}" />
            <Setter Property="ItemTemplate" Value="{DynamicResource {x:Type components:ItemTemplateSelector}}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <!--  Items control end  -->


        <!--  ToolTip  -->

        <Style Selector="ToolTip">
            <!--  Фон і закруглення  -->
            <Setter Property="Background" Value="{StaticResource PrimaryAccentColorDarkest}" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MaxWidth" Value="800" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                        <ContentPresenter
                            Padding="20,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            TextWrapping="Wrap" />
                    </Grid>

                </ControlTemplate>
            </Setter>
        </Style>

    </UserControl.Styles>

    <UserControl.DataTemplates>
        <components:ItemTemplateSelector ButtonTemplate="{StaticResource IngredientsButtonDataTemplate}" CheckBoxTemplate="{StaticResource IngredientsCBDataTemplate}" />
    </UserControl.DataTemplates>

    <Grid
        Margin="0,0,0,20"
        RowDefinitions="Auto *"
        ShowGridLines="False">
        <TextBlock
            FontSize="20"
            FontWeight="Bold"
            Foreground="{StaticResource SecondaryTextColor}"
            Text="{Binding GroupTitle, RelativeSource={RelativeSource AncestorType=components:IngredientItemsControl}}" />

        <ItemsControl
            Grid.Row="1"
            Margin="0,10,0,0"
            Classes="lbSoapComponents"
            ItemsSource="{Binding Ingredients, RelativeSource={RelativeSource AncestorType=components:IngredientItemsControl}}" />
    </Grid>

</UserControl>