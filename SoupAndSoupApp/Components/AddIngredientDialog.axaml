        <TextBlock
            Grid.Row="2"
            Margin="0,20,0,0"
            Text="Ціна (грн)" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="5">

            <TextBox
                Width="60"
                Text="{Binding Quantity}"
                Watermark="К-сть" />
            <TextBlock VerticalAlignment="Bottom" Text="{Binding AmountTypeTitle}" />
            <TextBlock Margin="20,0" Text="Х" />
            <TextBox Text="{Binding Price}" />
