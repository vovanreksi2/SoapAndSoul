<Window
    x:Class="SoupAndSoupApp.AddIngredientDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SoupAndSoupApp.Models"
    xmlns:soupAndSoupApp="clr-namespace:SoupAndSoupApp"
    xmlns:viewModels="clr-namespace:SoupAndSoupApp.ViewModels"
    Title="{Binding Title}"
    Width="480"
    x:DataType="viewModels:AddIngredientDialogViewModel"
    Background="White"
    SizeToContent="Height"
    SystemDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Design.DataContext>
        <viewModels:AddIngredientDialogViewModel />
    </Design.DataContext>


    <Window.Resources>
        <!--  Кольори Material  -->
        <Color x:Key="MaterialPrimaryColor">#7C3AED</Color>
        <Color x:Key="MaterialSurfaceColor">#FFFFFF</Color>
        <Color x:Key="MaterialSurfaceVariantColor">#F4F4F4</Color>
        <Color x:Key="MaterialOnSurfaceColor">#1A1A1A</Color>
        <Color x:Key="MaterialOnSurfaceVariantColor">#5F5F5F</Color>

        <SolidColorBrush x:Key="MaterialPrimary" Color="{DynamicResource MaterialPrimaryColor}" />
        <SolidColorBrush x:Key="MaterialSurface" Color="{DynamicResource MaterialSurfaceColor}" />
        <SolidColorBrush x:Key="MaterialSurfaceVariant" Color="{DynamicResource MaterialSurfaceVariantColor}" />
        <SolidColorBrush x:Key="MaterialOnSurface" Color="{DynamicResource MaterialOnSurfaceColor}" />
        <SolidColorBrush x:Key="MaterialOnSurfaceVariant" Color="{DynamicResource MaterialOnSurfaceVariantColor}" />
    </Window.Resources>

    <Window.Styles>
        <Styles>

            <Style Selector="TextBox">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style Selector="TextBox.outlined">
                <Setter Property="BorderBrush" Value="#DADADA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,4" />

            </Style>

            <Style Selector="Button.outlined">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#DADADA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style Selector="Button.rounded">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,6" />
            </Style>

            <Style Selector="Image.uploadPhoto">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Stretch" Value="Uniform" />
            </Style>

            <Style Selector="Image.uploadPhoto:not(:pointerover)">
                <Setter Property="Source" Value="/Assets/camera_icon.png" />
            </Style>

            <Style Selector="Image.uploadPhoto:pointerover">
                <Setter Property="Source" Value="/Assets/camera_icon_pressed.png" />
            </Style>


            <Style Selector="ListBox.lbMeasureTypes">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </Setter>
                <Setter Property="ItemTemplate">
                    <DataTemplate DataType="models:MeasureTypeModel">
                        <StackPanel
                            Width="70"
                            Orientation="Vertical"
                            Spacing="8">
                            <Image
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Center"
                                Source="{Binding Icon}" />
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter>
            </Style>
        </Styles>


    </Window.Styles>


    <Border
        Padding="32"
        Background="White"
        CornerRadius="12">
        <StackPanel Spacing="20">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding Title}" />

            <soupAndSoupApp:ImagePickerControl
                Height="300"
                ImageSource="{Binding Photo}"
                NewImagePath="{Binding NewImagePath, Mode=OneWayToSource}" />

            <!--  Назва  -->
            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Назва" />
                <TextBox
                    Height="40"
                    Classes="outlined"
                    Text="{Binding Name}"
                    Watermark="" />
            </StackPanel>

            <!--  Тип кількості  -->
            <StackPanel IsVisible="{Binding SelectedUseMeasureType.HasMultipleMeasureTypes}" Spacing="5">
                <ListBox
                    Classes="lbMeasureTypes"
                    ItemsSource="{Binding SelectedUseMeasureType.MeasureTypes}"
                    SelectedItem="{Binding SelectedUseMeasureType.Selected, Mode=TwoWay}" />
            </StackPanel>

            <!--  Типова порція  -->
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    IsVisible="{Binding IsAmountVisible}"
                    Text="{Binding SelectedUseMeasureType.Selected.ShortTitle, StringFormat='Типова порція в рецепті ({0})'}" />
                <TextBlock
                    Margin="0,0,0,4"
                    IsVisible="{Binding IsAmountVisible, Converter={StaticResource InvertBool}}"
                    Text="Вага мила (г)" />
                <TextBox
                    Height="40"
                    Classes="outlined"
                    Text="{Binding SuggestedAmount}"
                    Watermark="" />
            </StackPanel>

            <!--  Ціна і кількість  -->

            <TextBlock
                Margin="0,25,0,0"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Покупка" />

            <Grid
                Margin="0,0,0,4"
                HorizontalAlignment="Stretch"
                ColumnDefinitions="Auto Auto *"
                RowDefinitions="Auto *">

                <ListBox
                    Background="Transparent"
                    Classes="lbMeasureTypes"
                    IsVisible="False"
                    ItemsSource="{Binding SelectedBuyMeasureType.MeasureTypes}"
                    SelectedItem="{Binding SelectedBuyMeasureType.Selected, Mode=TwoWay}" />

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="160"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsAmountVisible}">
                    <TextBlock Margin="0,0,0,4" Text="{Binding SelectedBuyMeasureType.Selected.ShortTitle, StringFormat='Кількість ({0})'}" />
                    <TextBox
                        Height="40"
                        Classes="outlined"
                        Text="{Binding BuyAmount}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="30"
                    Margin="20,0,0,10"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    IsVisible="{Binding IsAmountVisible}"
                    Text="x" />

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch">
                    <TextBlock Margin="0,0,0,4" Text="Ціна (грн)" />
                    <TextBox
                        Height="40"
                        Classes="outlined"
                        Text="{Binding BuyPrice}" />
                </StackPanel>
            </Grid>

            <!--  Підсумок ціни  -->
            <Border
                Padding="12"
                Background="{DynamicResource MaterialSurfaceVariant}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image
                        Width="20"
                        Height="20"
                        Source="/Assets/lightbulb_icon.png" />
                    <TextBlock FontWeight="Medium" Foreground="{DynamicResource MaterialPrimary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Ціна за {0}: {1:F2} грн">
                                <Binding Path="SelectedUseMeasureType.Selected.ShortTitle" />
                                <Binding Path="UnitPrice" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="30">
                <Button
                    Classes="outlined"
                    Command="{Binding CancelCommand}"
                    Content="Скасувати"
                    IsCancel="True" />
                <Button
                    Background="#7C3AED"
                    Classes="rounded"
                    Command="{Binding ConfirmCommand}"
                    Foreground="White"
                    IsDefault="True">
                    <Button.Content>
                        <Grid>
                            <TextBlock IsVisible="{Binding IsEditMode, Converter={StaticResource InvertBool}}" Text="Додати" />
                            <TextBlock IsVisible="{Binding IsEditMode}" Text="Оновити" />
                        </Grid>
                    </Button.Content>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
