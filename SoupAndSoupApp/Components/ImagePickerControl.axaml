<UserControl
    x:Class="SoupAndSoupApp.ImagePickerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SoupAndSoupApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <converters:OpacityConverter x:Key="OpacityConverter" />

        <ControlTemplate x:Key="ButtonImageTemplate" TargetType="Button">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Classes="BorderStyle"
                CornerRadius="{TemplateBinding CornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.BorderStyle:pointerover">
                        <Setter Property="BoxShadow" Value="{Binding Source={StaticResource BorderColor}, Converter={StaticResource ColorToBoxShadowConverter}, ConverterParameter=20}" />
                    </Style>
                    <Style Selector="Border.BorderStyle:not(:pointerover)">
                        <Setter Property="BoxShadow" Value="{Binding Source={StaticResource BorderColor}, Converter={StaticResource ColorToBoxShadowConverter}, ConverterParameter=8}" />
                    </Style>
                </Border.Styles>

                <Grid RowDefinitions="* *">
                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From1To0.4'}"
                        Source="{Binding #RootControl.ImageSource}"
                        Stretch="Uniform">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>

                    <Grid
                        Grid.Row="0"
                        Width="48"
                        Height="48"
                        MaxWidth="70"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From0To1'}">
                        <Path Fill="{StaticResource PrimaryAccentColorDarkest}" Stretch="Uniform">
                            <Path.Data>
                                <GeometryGroup>
                                    <PathGeometry Figures="M16,10.001c-4.419,0-8,3.581-8,8c0,4.418,3.581,8,8,8 c4.418,0,8-3.582,8-8C24,13.583,20.418,10.001,16,10.001z M20.555,21.906c-2.156,2.516-5.943,2.807-8.459,0.65 c-2.517-2.156-2.807-5.944-0.65-8.459c2.155-2.517,5.943-2.807,8.459-0.65C22.42,15.602,22.711,19.391,20.555,21.906z" />
                                    <PathGeometry Figures="M16,14.001c-2.209,0-3.999,1.791-4,3.999v0.002 c0,0.275,0.224,0.5,0.5,0.5s0.5-0.225,0.5-0.5V18c0.001-1.656,1.343-2.999,3-2.999c0.276,0,0.5-0.224,0.5-0.5 S16.276,14.001,16,14.001z" />
                                    <PathGeometry Figures="M29.492,9.042l-4.334-0.723l-1.373-3.434 C23.326,3.74,22.232,3,21,3H11C9.768,3,8.674,3.74,8.214,4.886L6.842,8.319L2.509,9.042C1.055,9.283,0,10.527,0,12v15 c0,1.654,1.346,3,3,3h26c1.654,0,3-1.346,3-3V12C32,10.527,30.945,9.283,29.492,9.042z M30,27c0,0.553-0.447,1-1,1H3 c-0.553,0-1-0.447-1-1V12c0-0.489,0.354-0.906,0.836-0.986l5.444-0.907l1.791-4.478C10.224,5.25,10.591,5,11,5h10 c0.408,0,0.775,0.249,0.928,0.629l1.791,4.478l5.445,0.907C29.646,11.094,30,11.511,30,12V27z" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Grid.Transitions>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{StaticResource PrimaryAccentColorLighter}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From0To1'}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>

                        <TextBlock
                            FontSize="20"
                            Foreground="{StaticResource PrimaryTextColor}"
                            Text="Змінити фото" />
                    </Border>

                </Grid>
            </Border>
        </ControlTemplate>

    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.button-image">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ClipToBounds" Value="False" />

            <Setter Property="Template" Value="{StaticResource ButtonImageTemplate}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="MainButton" Classes="button-image" />

</UserControl>
