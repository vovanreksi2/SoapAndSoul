<UserControl
    x:Class="SoupAndSoupApp.ImagePickerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SoupAndSoupApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:soupAndSoupApp="clr-namespace:SoupAndSoupApp"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="soupAndSoupApp:ImagePickerControl"
    mc:Ignorable="d">

    <UserControl.Resources>

        <converters:OpacityConverter x:Key="OpacityConverter" />

        <ControlTemplate x:Key="ButtonImageTemplate" TargetType="Button">
            <Border
                x:Name="RootBorder"
                Background="Transparent"
                BorderBrush="{StaticResource IngredientBorderSolidColorBrush}"
                BorderThickness="2"
                BoxShadow="0 0 8 0 #33000000"
                ClipToBounds="True"
                CornerRadius="{TemplateBinding CornerRadius}">

                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow" Value="0 0 30 #66000000" />
                    </Style>
                </Border.Styles>

                <Grid>
                    <Image
                        x:Name="Image1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Opacity="{Binding IsHovered, RelativeSource={RelativeSource AncestorType=soupAndSoupApp:ImagePickerControl}, Converter={StaticResource OpacityConverter}}"
                        Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=soupAndSoupApp:ImagePickerControl}}"
                        Stretch="UniformToFill" />

                    <Image
                        MaxWidth="70"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsHovered, RelativeSource={RelativeSource AncestorType=soupAndSoupApp:ImagePickerControl}, Converter={StaticResource InvertBool}}"
                        Opacity="0.4"
                        Source="../Assets/camera_icon.png" />

                    <Image
                        MaxWidth="70"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsHovered, RelativeSource={RelativeSource AncestorType=soupAndSoupApp:ImagePickerControl}}"
                        Opacity="1"
                        Source="../Assets/camera_icon_pressed.png" />
                </Grid>
            </Border>
        </ControlTemplate>

    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.button-image">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource ButtonImageTemplate}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="MainButton" Classes="button-image" />

</UserControl>
