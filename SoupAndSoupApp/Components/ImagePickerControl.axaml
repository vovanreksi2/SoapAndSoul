<UserControl
    x:Class="SoupAndSoupApp.ImagePickerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SoupAndSoupApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:soupAndSoupApp="clr-namespace:SoupAndSoupApp"
    x:Name="RootControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <converters:OpacityConverter x:Key="OpacityConverter" />

        <ControlTemplate x:Key="ButtonImageTemplate" TargetType="Button">
            <Border
                x:Name="RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BoxShadow="0 0 8 0 #33000000"
                Classes="BorderStyle"
                CornerRadius="{TemplateBinding CornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.BorderStyle:pointerover">
                        <Setter Property="BoxShadow" Value="0 0 30 #66000000" />
                    </Style>
                </Border.Styles>

                <Grid RowDefinitions="* *">
                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From1To0.4'}"
                        Source="{Binding #RootControl.ImageSource}"
                        Stretch="Uniform">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>

                    <Image
                        Grid.Row="0"
                        MaxWidth="70"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From0To1'}"
                        Source="../Assets/camera_icon_pressed.png">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>

                    <Border
                        Grid.Row="1"
                        Padding="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="LightGray"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="{Binding #RootControl.IsPointerOver, Converter={StaticResource OpacityConverter}, ConverterParameter='From0To1'}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>

                        <TextBlock
                            FontSize="20"
                            Foreground="{StaticResource PrimarySolidColorBrush}"
                            Text="Змінити фото" />
                    </Border>

                </Grid>
            </Border>
        </ControlTemplate>

    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Rectangle.red">
            <Setter Property="Height" Value="100" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Fill" Value="Red" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Rectangle.red:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.button-image">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource IngredientBorderSolidColorBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ClipToBounds" Value="False" />

            <Setter Property="Template" Value="{StaticResource ButtonImageTemplate}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="MainButton" Classes="button-image" />

</UserControl>
